    "next": "16.2.5",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.11.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "tailwind-merge": "^3.5.0",
